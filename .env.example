PORT=3000
# Shared secret callers send as Authorization: Bearer ... or X-Webhook-Secret
WEBHOOK_SECRET=generate-a-long-random-string

# This service is the logistics API: use memory for local dev, then implement logisticsStore.js for DB.
LOGISTICS_STORE_MODE=memory
# Key for POST /api/v1/drivers/fcm-token (Flutter registers FCM); replace with JWT when ready.
LOGISTICS_API_KEY=another-long-random-string

# API-only (no DB): point these at your logistics API. Unset LOGISTICS_STORE_MODE or use stub;
# token/closed-bid resolution uses HTTP when URLs are set.
# TOKEN_LOOKUP_URL=https://vendcliq.cloud/logistics/internal/drivers/fcm-tokens
# INTERNAL_API_SECRET=Bearer JWT or shared secret your logistics expects
# CLOSED_BID_PARTNERS_LOOKUP_URL=https://vendcliq.cloud/logistics/internal/bid-requests/closed-partners

# File logging (default on). Set LOG_TO_FILE=false to disable.
# LOG_DIR=logs
# LOG_ACCESS_PATH=logs/access.log
# LOG_EVENTS_PATH=logs/events.log
# LOG_TO_FILE=true

# Android notification channel id (create the same channel in Flutter)
# FCM_ANDROID_CHANNEL_ID=driver_default

# FCM topic for “all drivers” (one send). Flutter must subscribe: subscribeToTopic(same name).
# With FCM_DRIVER_TOPIC set, webhooks that already send recipient "all" on bidcreate / bidrequestcreated
# automatically use this topic (no extra JSON fields). Optional overrides:
# - "broadcastToTopic": true on any event path that supports it
# - FCM_TOPIC_DEFAULT_FOR_BIDCREATE=true — topic for every bidcreate (even without recipient all)
# FCM_DRIVER_TOPIC=all_drivers
# FCM_TOPIC_DEFAULT_FOR_BIDCREATE=true

# Firebase (pick one)
# FCM_DISABLED=true
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\secrets\firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or on GCP / with gcloud: rely on application default credentials (no path needed)
