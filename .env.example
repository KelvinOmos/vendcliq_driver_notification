PORT=3000
# Shared secret callers send as Authorization: Bearer ... or X-Webhook-Secret
WEBHOOK_SECRET=generate-a-long-random-string

# Optional: partner UUIDs -> FCM tokens (your logistics API)
TOKEN_LOOKUP_URL=https://your-logistics-api.internal/internal/drivers/fcm-tokens
INTERNAL_API_SECRET=same-bearer-as-your-internal-routes

# Optional: bidRequestId -> partner UUIDs for CLOSED / recipient=all
CLOSED_BID_PARTNERS_LOOKUP_URL=https://your-logistics-api.internal/internal/bid-requests/closed-partners

# Firebase (pick one)
# FCM_DISABLED=true
# FIREBASE_SERVICE_ACCOUNT_PATH=C:\secrets\firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Or on GCP / with gcloud: rely on application default credentials (no path needed)
